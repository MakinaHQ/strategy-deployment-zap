{
  "name": "strategy-deployment-zap",
  "version": "v1.3.0",
  "description": "Makina strategy deployment zap contracts",
  "repository": "https://github.com/MakinaHQ/strategy-deployment-zap.git",
  "author": "MakinaHQ",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "prettier": "3.9.9",
    "solhint": "6.2.4"
  },
  "scripts": {
    "lint": "yarn lint:sol && yarn prettier:check",
    "lint:sol": "forge fmt --check && yarn solhint \"{script,src,test}/**/*.sol\"",
    "prettier:check": "prettier --check \"**/*.{js,json,md,yml}\" \"!script/deploy/outputs/**/*\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,yml}\" \"!script/deploy/outputs/**/*\"",
    "coverage": "forge coverage --no-match-coverage \"(script|test)\"",
    "coverage:debug": "forge coverage --no-match-coverage \"(script|test)\" --report debug"
  }
}
